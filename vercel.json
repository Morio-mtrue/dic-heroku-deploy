{
    "builds":[
        {
            "src": "python_heroku_task/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.11"
            }
        }
    ],
    "routes": [
        {
        "src": "/(.*)",
        "dest": "python_heroku_task/wsgi.py"
        }
    ]
}